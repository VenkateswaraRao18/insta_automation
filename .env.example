AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# 0.35–0.55 often gives tighter JSON for carousels; raise slightly if outputs feel repetitive
GEMINI_TEMPERATURE=0.5
# Buffer: Settings → API (same as Buffer docs); either name works.
BUFFER_ACCESS_TOKEN=your_buffer_access_token
# BUFFER_API_KEY=your_buffer_access_token
# Channel id from Buffer (GET /api/buffer/profiles → instagram row id).
BUFFER_PROFILE_ID=your_buffer_channel_id
# graphql = default (api.buffer.com). legacy = classic OAuth token for api.bufferapp.com.
BUFFER_API=graphql
# How Buffer gets slide images (pick one):
# A) Tunnel this app — Buffer fetches PUBLIC_BASE_URL/output/...
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# B) No tunnel — free key from https://api.imgbb.com/ uploads each PNG; paste key here:
# IMGBB_API_KEY=
# Instagram GraphQL: post type (optional). Default: post (1 image) or carousel (2+). Override: post | carousel | reel | story
# BUFFER_INSTAGRAM_POST_TYPE=
# BUFFER_INSTAGRAM_SHARE_TO_FEED=true
# Optional if you have several orgs; else first org is used.
# BUFFER_ORGANIZATION_ID=
# Optional: comma-separated channel ids (same post duplicated to each).
# BUFFER_PROFILE_IDS=id1,id2
# Minimum seconds in the future for scheduled_at (Buffer / network skew). Default 600.
# BUFFER_MIN_LEAD_SECONDS=600
# If set (e.g. 3), each carousel slide becomes its own scheduled post, staggered by N minutes (REST v1 is one image per update).
# BUFFER_STAGGER_MINUTES=0
# Set true only if form-encoded create fails for your account (default is form body per Buffer docs).
# BUFFER_CREATE_JSON=false
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_MS=1500
AI_FALLBACK_TO_OPENAI=true
# Optional: path to profile image for slide footers (default: data/profile.jpg)
PROFILE_IMAGE_PATH=
# Set to true to use file:// avatar instead of embedded data URL (rarely needed)
AVATAR_USE_FILE_URL=false
#
# Next.js UI: from repo root run `npm run dashboard:install` once, then `npm run dev:all` (or two terminals: `npm run api:dev` + `npm run dashboard:dev`)
# Open http://localhost:3001 (API stays on :3000). Override proxy: API_PROXY_TARGET=http://127.0.0.1:3000
#
# Local DB: copy data/posts.json.example to data/posts.json (or let the API create it on first run).
